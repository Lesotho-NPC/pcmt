{% extends '@PimUser/layout.html.twig' %}

{% block title %}Lesotho National Product Catalogue{% endblock %}

{% block head_style %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/core/css/login-custom.css') }}">
{% endblock %}

{% block bodyClass %}AknLogin PcmtLogin{% endblock %}

{% block messages %}
    {% if app.session.flashbag.peekAll|length > 0 %}
        {% for type, messages in app.session.flashbag.all %}
            {% for message in messages %}
                <div class="Helper {{ type ? ' Helper--' ~ type : '' }}">
                    <span class="Helper-icon">
                        {% if type == 'error' %}⚠️
                        {% elseif type == 'success' %}✓
                        {% elseif type == 'warning' %}⚠️
                        {% else %}ℹ️
                        {% endif %}
                    </span>
                    <span class="Helper-text">{{ message|trans|raw }}</span>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% if error %}
        <div class="Helper Helper--error">
            <span class="Helper-icon">⚠️</span>
            <span class="Helper-text">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
    {% endif %}
{% endblock %}

{% block main %}
    <script type="text/javascript" nonce="{{ js_nonce() }}">
      sessionStorage.clear();
      document.title = 'Lesotho National Product Catalogue';
    </script>

    <div class="PcmtLogin-page">
        <div class="PcmtLogin-shell">
            <!-- Brand Panel -->
            <section class="PcmtLogin-panel PcmtLogin-panel--brand" aria-label="National Product Catalogue information">
                <div class="PcmtLogin-brandTop">
                    
                    <div class="PcmtLogin-brandCopy">
                        <h1 class="PcmtLogin-heroTitle">
                            Lesotho National<br>Product Catalogue
                        </h1>
                        <p class="PcmtLogin-heroText">
                            A unified, reliable source for product data :- strengthening health supply chains,
                            improving visibility, and enabling better decisions across all programmes.
                        </p>
                    </div>

                    <ul class="PcmtLogin-highlights">
                        <li>Centralized & standardized product records</li>
                        <li>Trusted data governance & version control</li>
                        <li>Seamless integration with national systems</li>
                    </ul>
                </div>
                
                <div class="PcmtLogin-brandFooter">
                    <span>Ministry of Health</span>
                </div>
            </section>

            <!-- Form Panel -->
            <section class="PcmtLogin-panel PcmtLogin-panel--form">
                <div class="PcmtLogin-formStack">
                    <div class="PcmtLogin-formCrestFrame">
                        <img src="{{ asset('bundles/core/images/login/bophelo-crest.png') }}"
                             alt="Bophelo crest - Government of Lesotho"
                             class="PcmtLogin-formCrest" />
                    </div>

                    <div class="PcmtLogin-formCard">
                        <div class="PcmtLogin-formHeader">
                            <div class="PcmtLogin-formEyebrow">Signin to LNPC</div>
                            {# <h2 class="PcmtLogin-formTitle">Sign in</h2> #}
                            <p class="PcmtLogin-formIntro">
                                Access the national catalogue with your authorized credentials
                            </p>
                        </div>

                        <div class="Messages PcmtLogin-messages">
                            {{ block('messages') }}
                        </div>

                        <form action="{{ path(action_route) }}" method="post" class="Form form-signin PcmtLogin-form" id="loginForm">
                            <div class="InputGroup">
                                <div class="InputBlock">
                                    <label class="InputLabel" for="username_input">
                                        {{ 'pim_user.user.login.username_or_email'|trans }}
                                    </label>
                                    <div class="InputContainer">
                                        <input class="InputText" 
                                               type="text" 
                                               id="username_input" 
                                               autofocus="autofocus"
                                               name="_username" 
                                               value="{{ last_username }}" 
                                               required="required"
                                               placeholder="test@gov.ls"
                                               autocomplete="username" />
                                        <span class="input-icon user-icon"></span>
                                    </div>
                                </div>

                                <div class="InputBlock">
                                    <label class="InputLabel" for="password_input">
                                        {{ 'pim_user.user.fields.password'|trans }}
                                    </label>
                                    <div class="InputContainer">
                                        <input class="InputText" 
                                               type="password" 
                                               id="password_input" 
                                               name="_password" 
                                               required="required"
                                               placeholder="Enter your password"
                                               autocomplete="current-password" />
                                        <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                                            <svg class="eye-icon" viewBox="0 0 24 24" width="18" height="18">
                                                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="PcmtLogin-metaRow">
                                    <label class="RememberMe">
                                        <input type="checkbox" id="remember_me" name="_remember_me" value="on" />
                                        <span>{{ 'pim_user.user.login.remember_me'|trans }}</span>
                                    </label>

                                    <a href="{{ path('pim_user_reset_request') }}" class="PasswordReset">
                                        {{ 'pim_user.user.login.password_forgotten'|trans }}
                                    </a>
                                </div>
                            </div>

                            <button class="PcmtLogin-submit" type="submit" id="_submit" name="_submit">
                                <span class="btn-text">{{- 'pim_user.user.login.log_in'|trans -}}</span>
                                <svg class="btn-icon" viewBox="0 0 24 24" width="18" height="18">
                                    <path d="M5 13h11.86l-3.63 4.36a1 1 0 0 0 1.54 1.28l5-6a1.19 1.19 0 0 0 .09-.15c0-.05.05-.08.07-.13A1 1 0 0 0 20 12a1 1 0 0 0-.07-.36c0-.05-.05-.08-.07-.13a1.19 1.19 0 0 0-.09-.15l-5-6a1 1 0 0 0-1.54 1.28L16.86 11H5a1 1 0 0 0 0 2z" fill="currentColor"/>
                                </svg>
                            </button>

                            <input type="hidden" name="_target_path" value="" />
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />
                            {% for field in additional_hidden_fields %}
                                <input type="hidden" name="{{ field.field_name }}" value="{{ app.request.query.get(field.initialized_by) }}" />
                            {% endfor %}
                        </form>

                        <div class="PcmtLogin-formFooter">
                            <div class="security-badge">
                                <span class="lock-icon">🔒</span>
                                <span>Secured by Government of Lesotho</span>
                            </div>
                            <p class="PcmtLogin-support">
                                Need help? <a href="mailto:support@npc.gov.ls">Contact NPC Support</a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block deferred_javascript %}
    {{ parent() }}
    <script src="{{ asset('bundles/core/js/login-custom.js') }}" nonce="{{ js_nonce() }}"></script>
    <script type="text/javascript" nonce="{{ js_nonce() }}">
      (function () {
        const username = document.getElementById('username_input');
        const password = document.getElementById('password_input');
        const submit = document.getElementById('_submit');
        const form = document.querySelector('form.Form');

        if (typeof initPimLoginForm === 'function') {
          initPimLoginForm([username, password], submit, form);
        }
      })();
    </script>
{% endblock %}