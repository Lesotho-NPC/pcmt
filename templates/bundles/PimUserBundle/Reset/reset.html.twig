{% extends '@PimUser/layout.html.twig' %}

{% block title %}Set New Password | Lesotho National Product Catalogue{% endblock %}

{% block head_style %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/core/css/login-custom.css') }}">
{% endblock %}

{% block bodyClass %}AknLogin PcmtLogin{% endblock %}

{% block messages %}
    {% if app.session.flashbag.peekAll|length > 0 %}
        {% for type, messages in app.session.flashbag.all %}
            {% for message in messages %}
                <div class="Helper {{ type ? ' Helper--' ~ type : '' }}">
                    <span class="Helper-icon">{% if type == 'success' %}✓{% else %}⚠️{% endif %}</span>
                    <span class="Helper-text">{{ message|trans|raw }}</span>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% for error in form.vars.errors %}
        <div class="Helper Helper--error">
            <span class="Helper-icon">⚠️</span>
            <span class="Helper-text">{{ error.message|trans }}</span>
        </div>
    {% endfor %}
{% endblock %}

{% block main %}
    <div class="PcmtLogin-page">
        <div class="PcmtLogin-shell">
            <section class="PcmtLogin-panel PcmtLogin-panel--brand" aria-label="National Product Catalogue information">
                <div class="PcmtLogin-brandTop">
                    <div class="PcmtLogin-brandCopy">
                        <h1 class="PcmtLogin-heroTitle">
                            Create a New<br>Password
                        </h1>
                        <p class="PcmtLogin-heroText">
                            Choose a strong password to protect your account and keep access secure.
                        </p>
                    </div>

                    <ul class="PcmtLogin-highlights">
                        <li>Use at least 8 characters</li>
                        <li>Mix letters, numbers, and symbols</li>
                        <li>Avoid reusing previous passwords</li>
                    </ul>
                </div>

                <div class="PcmtLogin-brandFooter">
                    <span>Ministry of Health</span>
                </div>
            </section>

            <section class="PcmtLogin-panel PcmtLogin-panel--form">
                <div class="PcmtLogin-formStack">
                    <div class="PcmtLogin-formCrestFrame">
                        <img src="{{ asset('bundles/core/images/login/bophelo-crest.png') }}"
                             alt="Bophelo crest - Government of Lesotho"
                             class="PcmtLogin-formCrest" />
                    </div>

                    <div class="PcmtLogin-formCard">
                        <div class="PcmtLogin-formHeader">
                            <div class="PcmtLogin-formEyebrow">Password Reset</div>
                            <p class="PcmtLogin-formIntro">
                                Enter and confirm your new password
                            </p>
                        </div>

                        <div class="Messages PcmtLogin-messages">
                            {{ block('messages') }}
                        </div>

                        {{ form_start(form, {
                            action: path('pim_user_reset_reset', {token: token}),
                            method: 'post',
                            attr: {'class': 'Form PcmtLogin-form', 'id': 'resetPasswordForm'}
                        }) }}
                        <div class="InputGroup">
                            <div class="InputBlock">
                                <label class="InputLabel" for="{{ form.plainPassword.first.vars.id }}">
                                    New password
                                </label>
                                <div class="InputContainer">
                                    {{ form_widget(form.plainPassword.first, {
                                        attr: {
                                            class: 'InputText',
                                            required: 'required',
                                            autocomplete: 'new-password',
                                            placeholder: 'Enter new password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                                        <svg class="eye-icon" viewBox="0 0 24 24" width="18" height="18">
                                            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/>
                                        </svg>
                                    </button>
                                </div>
                                {% for error in form.plainPassword.first.vars.errors %}
                                    <div class="Helper Helper--error">
                                        <span class="Helper-icon">⚠️</span>
                                        <span class="Helper-text">{{ error.message|trans }}</span>
                                    </div>
                                {% endfor %}
                            </div>

                            <div class="InputBlock">
                                <label class="InputLabel" for="{{ form.plainPassword.second.vars.id }}">
                                    Confirm password
                                </label>
                                <div class="InputContainer">
                                    {{ form_widget(form.plainPassword.second, {
                                        attr: {
                                            class: 'InputText',
                                            required: 'required',
                                            autocomplete: 'new-password',
                                            placeholder: 'Repeat new password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                                        <svg class="eye-icon" viewBox="0 0 24 24" width="18" height="18">
                                            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/>
                                        </svg>
                                    </button>
                                </div>
                                {% for error in form.plainPassword.second.vars.errors %}
                                    <div class="Helper Helper--error">
                                        <span class="Helper-icon">⚠️</span>
                                        <span class="Helper-text">{{ error.message|trans }}</span>
                                    </div>
                                {% endfor %}
                            </div>

                            <div class="PcmtLogin-metaRow">
                                <a href="{{ path('pim_user_security_login') }}" class="PasswordReset">
                                    {{ 'pim_common.cancel'|trans }}
                                </a>
                            </div>
                        </div>

                        <button type="submit" id="_submit" class="PcmtLogin-submit">
                            <span class="btn-text">{{- 'pim_user.user.login.reset'|trans -}}</span>
                        </button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block deferred_javascript %}
    {{ parent() }}
    <script src="{{ asset('bundles/core/js/login-custom.js') }}" nonce="{{ js_nonce() }}"></script>
    <script type="text/javascript" nonce="{{ js_nonce() }}">
      (function () {
        const passwordFirst = document.getElementById('pim_user_reset_form_plainPassword_first');
        const passwordSecond = document.getElementById('pim_user_reset_form_plainPassword_second');
        const submit = document.getElementById('_submit');
        const form = document.querySelector('form.Form');

        if (typeof initPimLoginForm === 'function') {
          initPimLoginForm([passwordFirst, passwordSecond], submit, form);
        }
      })();
    </script>
{% endblock %}
